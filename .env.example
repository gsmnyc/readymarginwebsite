# The public Sites review is a staging environment and deliberately noindex.
SITE_URL=https://readymargin.com
SITE_ENV=staging
# Set SITE_ENV=production only on the final business launch deployment. Vercel's
# VERCEL_ENV=production is accepted automatically for the production target.
# Keep the canonical URL aligned with the real production domain.

# Optional Sanity content. All routes work from content/site.json without these.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only used by the local seed command. Never exposed to browsers or committed.
SANITY_WRITE_TOKEN=

# HTTPS provider endpoint that acknowledges accepted requests with 2xx.
# Unset = visible 503/email fallback; never a false success.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Set to apps-script when LEAD_WEBHOOK_URL is a Google Apps Script web-app URL.
# The adapter sends the token in the server-side JSON body and requires {"ok":true}.
LEAD_WEBHOOK_MODE=

# Existing intake deployment. Used only when LEAD_WEBHOOK_URL is unset.
GOOGLE_APPS_SCRIPT_URL=

# Enable Vercel Web Analytics and Speed Insights in the project dashboard.
# The browser sends only allowlisted, consented custom event names; no form
# fields, diagnostic values, query strings or user identifiers are sent.
